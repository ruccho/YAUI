{
    "name": "com.ruccho.yaui",
    "version": "0.1.0",
    "displayName": "YAUI",
    "description": "Yet Another Unity UI",
    "license": "MIT",
    "unity": "6000.7",
    "unityRelease": "0b2",
    "dependencies": {
        "com.unity.burst": "2.0.0",
        "com.unity.collections": "6.7.0",
        "com.unity.render-pipelines.universal": "17.7.0",
        "com.unity.ugui": "2.7.0"
    },
    "author": {
        "name": "ruccho",
        "url": "https://ruccho.com"
    },
    "samples": [
        {
            "displayName": "Basic",
            "description": "A panel with text and a button handled through the EventSystem.",
            "path": "Samples~/Basic"
        },
        {
            "displayName": "Custom Shader",
            "description": "A custom material for elements, built on Yaui.hlsl.",
            "path": "Samples~/CustomShader"
        },
        {
            "displayName": "Controls",
            "description": "Buttons, toggles, a slider, input fields and a scroll view, handled through the EventSystem.",
            "path": "Samples~/Controls"
        },
        {
            "displayName": "Particles",
            "description": "ParticleSystems in the draw order of the UI with YauiParticle, clipped and masked.",
            "path": "Samples~/Particles"
        }
    ]
}
